# ==============================================================================
# Nuuvixx Platform Environment Variables & Production Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Metadata & Canonical URLs (Public)
# ------------------------------------------------------------------------------
# Canonical production domain used for sitemap.xml, robots.txt, and metadata
NEXT_PUBLIC_SITE_URL=https://nuuvixx.com

# Monitored commercial contact email displayed across inquiry forms and legal footer
NEXT_PUBLIC_CONTACT_EMAIL=hello@nuuvixx.com

# ------------------------------------------------------------------------------
# 2. Web Application Database Persistence (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Managed PostgreSQL database connection string using least-privilege `nuuvixx_app` role.
#
# FOR VERCEL SERVERLESS HOSTING (Supabase Supavisor Transaction Pooler, Port 6543):
# Notice: When connecting through Supavisor pooler, the username format MUST be `[role].[project_ref]`.
# Format: postgresql://nuuvixx_app.[PROJECT_REF]:[APP_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# FOR DIRECT SESSIONS (Port 5432):
# Format: postgresql://nuuvixx_app:[APP_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional: Supported alias for DATABASE_URL (commonly supplied by Vercel Postgres / Neon integrations)
POSTGRES_URL=

# Set to "true" only in local staging/development if testing without a live PostgreSQL instance.
# When true, inquiries are stored locally in `.leads/inquiries.jsonl`.
# In production (NODE_ENV=production), this MUST remain false or unset.
ALLOW_DEV_LOCAL_STORAGE=false

# ------------------------------------------------------------------------------
# 3. Scheduled Retention Worker Database Persistence (GitHub Actions Secret)
# ------------------------------------------------------------------------------
# Dedicated connection string for the daily 90-day retention cleanup runner.
# Uses the isolated `nuuvixx_cleanup` role (SELECT + column-level UPDATE on PII fields).
# Configure this in GitHub: Repository Settings -> Secrets and variables -> Actions -> New repository secret.
#
# Pooler Format: postgresql://nuuvixx_cleanup.[PROJECT_REF]:[CLEANUP_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
RETENTION_DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. Strict TLS Certificate Handling (Optional / Fallback)
# ------------------------------------------------------------------------------
# Nuuvixx automatically resolves `src/lib/leads/certs/supabase-root-ca.crt` on disk.
# If hosting on an environment with an ephemeral or restricted filesystem, paste the
# contents of the Supabase Root CA certificate (PEM format) into this variable.
DATABASE_CA_CERT=

# Optional: Path to custom CA certificate file if not using default cert bundle
DATABASE_CA_FILE=

# ------------------------------------------------------------------------------
# 5. Privacy & Security Hashing (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Secret salt used for one-way HMAC-SHA256 client IP hashing (GDPR/CCPA compliant).
# Prevents storing raw IP addresses while allowing distributed 10-minute rate limiting.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADS_IP_SALT=change-this-to-a-secure-random-64-character-hex-salt-in-production

# ------------------------------------------------------------------------------
# 6. Outbound Webhook Notifications (Optional Notification Layer)
# ------------------------------------------------------------------------------
# Inquiries are first durably saved to PostgreSQL. Afterwards, an asynchronous notification
# is dispatched to your team's webhook endpoint (Discord, Slack, Zapier, or internal CRM).
#
# Webhook Examples:
# LEADS_WEBHOOK_URL=https://your-domain.com/api/leads-webhook
# LEADS_WEBHOOK_URL=https://webhook.site/your-endpoint-uuid
LEADS_WEBHOOK_URL=

# Optional: HMAC-SHA256 secret for signing outbound webhook payloads.
# When provided, Nuuvixx sends an `X-Nuuvixx-Signature-256` header on all webhook dispatches.
LEADS_WEBHOOK_SECRET=
